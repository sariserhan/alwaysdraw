# Copy to .env.local and fill in what you need. See README.md's "Environment
# variables" section for the quick version.

# --- Convex ---
# Written automatically by `npx convex dev` on first run — you don't set
# these by hand locally. Only relevant here as a reference for what a
# production build needs to have set (in the Cloudflare dashboard's build
# environment variables, since NEXT_PUBLIC_* vars are inlined at build time —
# see DEPLOYMENT.md).
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Admin passcode — gates the admin panel (Shift+A): area wipe, client
# rollback, protected zones, broadcasts, comment moderation, telemetry.
# No fallback: unset means no working passcode at all, not a guessable
# default. Pick any string for local dev.
ADMIN_SECRET_KEY=

# --- Gemini AI Drawing Engine (Optional) ---
# API key from Google AI Studio (https://aistudio.google.com/).
# Used by /api/ai-draw to generate dynamic vector path drawings via Gemini 2.0 Flash.
# Unset means the AI Artist Agent uses local procedural path synthesis.
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=

# --- Sentry (optional) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time only, used to upload source maps — never expose to the client.
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# --- PostHog (optional — deliberately not active yet, see ROADMAP.md) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- App metadata (optional) ---
# Falls back to NODE_ENV / no release / the production Cloudflare URL if unset.
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_APP_RELEASE=
NEXT_PUBLIC_SITE_URL=

# Google Search Console meta-tag verification — from Search Console, add a
# property for the site, pick "HTML tag" verification, and paste just the
# content="..." value here (not the whole <meta> tag). Unset renders no tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Ops / testing ---
# Incident switch: set to "1" to make every write-path mutation reject
# immediately (see convex/abuse.ts's assertWritesEnabled).
ALWAYSDRAW_READ_ONLY=
# Target URL for `npm run smoke:production`.
ALWAYSDRAW_SMOKE_URL=
# Enables the opt-in live two-browser multiplayer E2E test
# (`npm run test:e2e:live`). Must point at a non-production Convex
# deployment — the test writes real strokes and the wall is permanent.
ALWAYSDRAW_E2E_LIVE=
